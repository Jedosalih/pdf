# Template for docker-compose.prod.yml. Copy to .env.production (never
# commit it; .gitignore covers it) and replace every value.
# Generate secrets with:  openssl rand -hex 32
# Never reuse values from .env.example or a development .env.

# Public hostnames (DNS A/AAAA records must point at this host; Caddy
# obtains HTTPS certificates for both automatically).
APP_DOMAIN="jpdf.example.com"
FILES_DOMAIN="files.jpdf.example.com"
ACME_EMAIL="admin@example.com"

AUTH_SECRET="replace-me"
GUEST_ID_SECRET="replace-me"

# Postgres admin (migrations only) + one login role per service.
POSTGRES_DB="jpdf"
POSTGRES_USER="jpdf_admin"
POSTGRES_PASSWORD="replace-me"
POSTGRES_APP_PASSWORD="replace-me"
POSTGRES_WORKER_PASSWORD="replace-me"
POSTGRES_CLEANUP_PASSWORD="replace-me"

REDIS_PASSWORD="replace-me"

# Object storage (SeaweedFS): one key pair per service.
# Keys and secrets: letters, digits, "-" and "_" only (openssl rand -hex 32).
STORAGE_BUCKET="jpdf"
STORAGE_APP_ACCESS_KEY="jpdf-app"
STORAGE_APP_SECRET_KEY="replace-me"
STORAGE_WORKER_ACCESS_KEY="jpdf-worker"
STORAGE_WORKER_SECRET_KEY="replace-me"
STORAGE_CLEANUP_ACCESS_KEY="jpdf-cleanup"
STORAGE_CLEANUP_SECRET_KEY="replace-me"

# SMTP for verification / password-reset email (TLS required in production).
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_TLS_MODE="starttls"
SMTP_USER="replace-me"
SMTP_PASSWORD="replace-me"
EMAIL_FROM="JPdf <no-reply@jpdf.example.com>"

# Optional abuse-control overrides (defaults in lib/security/abuseLimits.ts).
# UPLOAD_RATE_LIMIT_PER_IP=200
# UPLOAD_RATE_LIMIT_PER_ACTOR=100
# JOB_RATE_LIMIT_PER_IP=200
# JOB_RATE_LIMIT_PER_ACTOR=100
# GUEST_DAILY_JOBS_PER_IP=300
