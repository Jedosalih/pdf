{
  "name": "jpdf-worker-pdf",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "sync:schema": "node -e \"require('fs').mkdirSync('prisma',{recursive:true});require('fs').copyFileSync('../../prisma/schema.prisma','prisma/schema.prisma')\"",
    "db:generate": "npm run sync:schema && prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bullmq": "^6.3.4",
    "diff": "^9.0.0",
    "ioredis": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "pixelmatch": "^7.2.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/diff": "^7.0.2",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/pixelmatch": "^5.2.6",
    "prisma": "^7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
