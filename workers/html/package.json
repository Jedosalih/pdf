{
  "name": "jpdf-worker-html",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "sync:schema": "node -e \"require('fs').mkdirSync('prisma',{recursive:true});require('fs').copyFileSync('../../prisma/schema.prisma','prisma/schema.prisma')\"",
    "db:generate": "npm run sync:schema && prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "bullmq": "^6.3.4",
    "ioredis": "^6.0.0",
    "markdown-it": "^14.1.0",
    "pg": "^8.23.0",
    "playwright": "^1.62.1",
    "sanitize-html": "^2.15.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.0",
    "prisma": "^7.10.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
