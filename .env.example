# Copy to .env for local development. Never commit the real .env file.

# --- Database ---
DATABASE_URL="postgresql://jdpdf:jdpdf@localhost:5432/jdpdf?schema=public"

# --- Redis / Queue ---
REDIS_URL="redis://localhost:6379"

# --- Object storage (S3-compatible: MinIO locally, R2/S3 in production) ---
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="auto"
STORAGE_BUCKET="jdpdf-dev"
STORAGE_ACCESS_KEY="jdpdf"
STORAGE_SECRET_KEY="jdpdf12345"
STORAGE_FORCE_PATH_STYLE="true"

# --- Malware scanning (optional; uploads are structurally validated
# either way — see docs/SECURITY.md §9). Leave unset to skip scanning
# (e.g. in CI without the `clamav` Compose service running). ---
CLAMD_HOST="localhost"
CLAMD_PORT="3310"

# --- Auth ---
AUTH_SECRET="replace-with-a-32+-byte-random-string"
GUEST_ID_SECRET="replace-with-a-different-32+-byte-random-string"

# --- App ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NODE_ENV="development"

# --- Email (plain SMTP; lib/email/mailer.ts) ---
# Verification and password-reset emails. Any SMTP mailbox/server works.
# Locally, leave SMTP_HOST unset: outside production the app then sends to
# the Mailpit capture server in docker-compose.yml (UI: http://localhost:8025).
# Production requires SMTP_HOST and EMAIL_FROM, and refuses SMTP_TLS_MODE=none.
#   SMTP_TLS_MODE: starttls (port 587, upgrade required) | tls (port 465) | none
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_TLS_MODE="starttls"
# SMTP_USER=""
# SMTP_PASSWORD=""
EMAIL_FROM="JPdf <no-reply@localhost>"
